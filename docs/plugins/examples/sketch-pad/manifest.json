{
  "id": "sketch-pad",
  "version": "0.1.0",
  "tmApi": "^1",
  "name": {
    "en": "Sketch Pad",
    "zh-TW": "隨手畫"
  },
  "description": {
    "en": "A personal note and drawing canvas. Change ink, pen width and grid; undo strokes. Saved locally, with no network access.",
    "zh-TW": "可自訂筆記及繪圖區。調整筆色、筆寬、格線，復原筆劃；只在本機儲存，不存取網絡。"
  },
  "author": "Token Monitor examples",
  "main": "main.js",
  "permissions": [],
  "visible": {
    "intervalSeconds": 2
  },
  "metrics": [
    {
      "id": "state",
      "kind": "object"
    },
    {
      "id": "drawing",
      "kind": "draw"
    }
  ],
  "views": [
    {
      "id": "canvas",
      "title": {
        "en": "My sketch",
        "zh-TW": "我的畫布"
      },
      "icon": "chart",
      "surfaces": [
        "home",
        "page",
        "edgeDock",
        "notch"
      ],
      "layout": {
        "type": "stack",
        "dir": "col",
        "gap": 14,
        "children": [
          {
            "type": "input",
            "action": "note",
            "label": {
              "en": "Your note",
              "zh-TW": "你的筆記"
            },
            "placeholder": {
              "en": "What are you working on?",
              "zh-TW": "正在做甚麼？"
            },
            "value": {
              "$": "@state",
              "field": "note"
            },
            "maxLength": 160
          },
          {
            "type": "stack",
            "dir": "row",
            "gap": 12,
            "wrap": true,
            "children": [
              {
                "type": "select",
                "action": "color",
                "label": {
                  "en": "Ink",
                  "zh-TW": "筆色"
                },
                "value": {
                  "$": "@state",
                  "field": "color"
                },
                "options": [
                  {
                    "value": "accent",
                    "label": {
                      "en": "Accent",
                      "zh-TW": "強調色"
                    }
                  },
                  {
                    "value": "chart",
                    "label": {
                      "en": "Chart",
                      "zh-TW": "圖表色"
                    }
                  },
                  {
                    "value": "warn",
                    "label": {
                      "en": "Amber",
                      "zh-TW": "琥珀"
                    }
                  },
                  {
                    "value": "default",
                    "label": {
                      "en": "Text",
                      "zh-TW": "文字色"
                    }
                  }
                ],
                "flex": 1
              },
              {
                "type": "slider",
                "action": "width",
                "label": {
                  "en": "Pen width",
                  "zh-TW": "筆寬"
                },
                "value": {
                  "$": "@state",
                  "field": "width"
                },
                "min": 1,
                "max": 12,
                "step": 1,
                "flex": 2
              },
              {
                "type": "toggle",
                "action": "grid",
                "label": {
                  "en": "Grid",
                  "zh-TW": "格線"
                },
                "value": {
                  "$": "@state",
                  "field": "grid"
                }
              }
            ]
          },
          {
            "type": "draw",
            "action": "canvas",
            "label": {
              "en": "Sketch canvas. Arrow keys move; Enter starts or ends a stroke.",
              "zh-TW": "繪圖區。方向鍵移動，Enter 開始或結束筆劃。"
            },
            "width": 480,
            "height": 240,
            "list": {
              "$": "@drawing"
            }
          },
          {
            "type": "stack",
            "dir": "row",
            "gap": 12,
            "children": [
              {
                "type": "button",
                "action": "undo",
                "label": {
                  "en": "Undo stroke",
                  "zh-TW": "復原筆劃"
                },
                "disabled": {
                  "$": "@state",
                  "field": "empty"
                }
              },
              {
                "type": "button",
                "action": "clear",
                "label": {
                  "en": "Clear drawing",
                  "zh-TW": "清除繪圖"
                },
                "disabled": {
                  "$": "@state",
                  "field": "empty"
                }
              },
              {
                "type": "text",
                "text": {
                  "$": "@state",
                  "field": "status"
                },
                "tone": "muted",
                "flex": 1
              }
            ]
          },
          {
            "type": "text",
            "text": {
              "en": "Drag to draw · arrows + Enter for keyboard drawing · saved on this device",
              "zh-TW": "拖曳繪圖 · 方向鍵及 Enter 鍵盤繪圖 · 儲存於此裝置"
            },
            "size": "xs",
            "tone": "muted"
          }
        ]
      },
      "compact": {
        "label": {
          "en": "Sketch Pad",
          "zh-TW": "隨手畫"
        },
        "value": {
          "$": "@state",
          "field": "note"
        }
      },
      "layouts": {
        "notch": {
          "type": "stack",
          "dir": "col",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "text": {
                "$": "@state",
                "field": "note"
              }
            },
            {
              "type": "draw",
              "width": 480,
              "height": 240,
              "list": {
                "$": "@drawing"
              }
            }
          ]
        }
      }
    }
  ],
  "skins": [
    {
      "id": "paper",
      "name": {
        "en": "Drawing paper",
        "zh-TW": "畫紙"
      },
      "colors": {
        "accent": "#4967ca",
        "chart": "#6d56ad"
      },
      "appearance": {
        "font": "system",
        "density": "comfortable",
        "corners": "rounded",
        "panel": "soft"
      }
    }
  ],
  "identityIcon": "data:image/png;base64,"
}
