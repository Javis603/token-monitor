{
  "id": "page-studio",
  "name": {
    "en": "Page Studio",
    "zh-TW": "頁面工作室"
  },
  "version": "0.1.0",
  "tmApi": 1,
  "author": "Token Monitor examples",
  "description": {
    "en": "Animated model, tool and device pages using packaged web UI.",
    "zh-TW": "以包內網頁介面呈現模型、工具及裝置，支援自訂動畫。"
  },
  "permissions": [
    "ui.web",
    "tm.pages",
    "sys.details"
  ],
  "webUi": {
    "version": 1,
    "assets": [
      "index.html",
      "page.css",
      "page.js",
      "mark.svg"
    ],
    "documents": [
      {
        "id": "model",
        "title": "Model canvas",
        "entry": "index.html",
        "target": "model",
        "slot": "replace",
        "height": 460
      },
      {
        "id": "tool",
        "title": "Tool canvas",
        "entry": "index.html",
        "target": "tool",
        "slot": "replace",
        "height": 460
      },
      {
        "id": "device",
        "title": "Device canvas",
        "entry": "index.html",
        "target": "device",
        "slot": "replace",
        "height": 460
      }
    ]
  }
}
