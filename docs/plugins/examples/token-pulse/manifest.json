{
  "id": "token-pulse",
  "version": "0.1.0",
  "tmApi": "^1",
  "name": {
    "en": "Token Pulse",
    "zh-TW": "Token 脈搏"
  },
  "description": {
    "en": "Tokens per minute as a live equalizer, tinted by CPU load, with a runaway-agent alert that keeps watching in the background.",
    "zh-TW": "以即時等化器顯示每分鐘 Token 用量，依 CPU 負載變色，並在背景監測異常用量及發送通知。"
  },
  "author": "Token Monitor examples",
  "main": "main.js",
  "permissions": [
    "tm.usage",
    "sys.cpu",
    "notify"
  ],
  "visible": {
    "intervalSeconds": 2
  },
  "background": {
    "intervalSeconds": 30
  },
  "metrics": [
    {
      "id": "tpm",
      "kind": "number",
      "label": "Tokens / min"
    },
    {
      "id": "pulse",
      "kind": "draw"
    },
    {
      "id": "mini",
      "kind": "draw"
    },
    {
      "id": "peak",
      "kind": "text"
    }
  ],
  "views": [
    {
      "id": "pulse",
      "title": {
        "en": "Token Pulse",
        "zh-TW": "Token 脈搏"
      },
      "icon": "pulse",
      "surfaces": [
        "home",
        "notch",
        "edgeDock",
        "tray",
        "page"
      ],
      "compact": {
        "label": {
          "en": "TPM",
          "zh-TW": "每分鐘"
        },
        "value": {
          "$": "@tpm",
          "fmt": "compact"
        }
      },
      "tray": {
        "draw": {
          "$": "@mini"
        },
        "width": 30
      },
      "layout": {
        "type": "stack",
        "dir": "col",
        "gap": 8,
        "children": [
          {
            "type": "stack",
            "dir": "row",
            "justify": "between",
            "align": "end",
            "children": [
              {
                "type": "stat",
                "label": {
                  "en": "Tokens / min",
                  "zh-TW": "每分鐘 Token"
                },
                "value": {
                  "$": "@tpm",
                  "fmt": "compact"
                },
                "size": "l"
              },
              {
                "type": "text",
                "text": {
                  "$": "@peak",
                  "fmt": "text"
                },
                "size": "xs",
                "tone": "muted"
              }
            ]
          },
          {
            "type": "draw",
            "width": 400,
            "height": 120,
            "list": {
              "$": "@pulse"
            }
          }
        ]
      },
      "layouts": {
        "notch": {
          "type": "stack",
          "dir": "row",
          "gap": 24,
          "align": "center",
          "children": [
            {
              "type": "stack",
              "dir": "col",
              "gap": 6,
              "children": [
                {
                  "type": "stat",
                  "label": {
                    "en": "Tokens / min",
                    "zh-TW": "每分鐘 Token"
                  },
                  "value": {
                    "$": "@tpm",
                    "fmt": "compact"
                  },
                  "size": "l"
                },
                {
                  "type": "text",
                  "text": {
                    "$": "@peak",
                    "fmt": "text"
                  },
                  "size": "xs",
                  "tone": "muted"
                },
                {
                  "type": "badge",
                  "text": {
                    "$": "sys.cpu",
                    "fmt": "percent"
                  },
                  "tone": {
                    "$": "sys.cpu",
                    "steps": [
                      [
                        0,
                        "ok"
                      ],
                      [
                        70,
                        "warn"
                      ],
                      [
                        90,
                        "bad"
                      ]
                    ]
                  }
                }
              ]
            },
            {
              "type": "draw",
              "width": 400,
              "height": 120,
              "list": {
                "$": "@pulse"
              },
              "flex": 1
            }
          ]
        }
      }
    }
  ],
  "skins": [
    {
      "id": "neon-night",
      "name": {
        "en": "Neon Night",
        "zh-TW": "霓虹夜"
      },
      "colors": {
        "accent": "#7cf7d4",
        "chart": "#ff6ad5",
        "bg": "#120f24",
        "text": "#f2eefe",
        "muted": "#9d95c4"
      }
    }
  ],
  "identityIcon": "data:image/png;base64,"
}
