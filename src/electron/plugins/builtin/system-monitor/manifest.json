        "pt-BR": "Memória"
      },
      "icon": "memory",
      "surfaces": [
        "edgeDock",
        "tray",
        "home"
      ],
      "compact": {
        "label": {
          "en": "MEM",
          "zh-TW": "記憶體",
          "zh-CN": "内存",
          "ja": "メモリ",
          "ko": "메모리",
          "pt-BR": "MEM"
        },
        "value": {
          "$": "sys.memory",
          "field": "percent",
          "fmt": "percent"
        },
        "tone": {
          "$": "sys.memory",
