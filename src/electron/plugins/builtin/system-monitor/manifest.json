      },
      "layout": {
        "type": "stack",
        "dir": "col",
        "gap": 8,
        "children": [
          {
            "type": "stack",
            "dir": "row",
            "justify": "between",
            "align": "end",
            "children": [
              {
                "type": "stat",
                "label": "CPU",
                "value": {
                  "$": "sys.cpu",
                  "fmt": "percent"
                },
                "size": "l",
                "tone": {
                  "$": "sys.cpu",
                  "steps": [
                    [
                      0,
