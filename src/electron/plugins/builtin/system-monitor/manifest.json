  ],
  "alerts": [
    {
      "id": "cpu-high",
      "title": {
        "en": "CPU is busy",
        "zh-TW": "CPU 持續繁忙",
        "zh-CN": "CPU 持续繁忙",
        "ja": "CPU が高負荷です",
        "ko": "CPU 사용량이 높습니다",
        "pt-BR": "CPU ocupada"
      },
      "source": {
        "$": "sys.cpu",
        "fmt": "percent"
      },
      "op": ">=",
      "value": 90,
      "forSeconds": 60,
      "cooldownMinutes": 30,
      "message": {
        "en": "CPU has stayed at {value} for a minute.",
        "zh-TW": "CPU 已經維持 {value} 一分鐘。",
        "zh-CN": "CPU 已维持 {value} 一分钟。",
        "ja": "CPU が 1 分間 {value} のままです。",
        "ko": "CPU가 1분 동안 {value}에 머물렀습니다.",
        "pt-BR": "A CPU ficou em {value} por um minuto."
      }
    },
    {
      "id": "memory-high",
      "title": {
        "en": "Memory is nearly full",
        "zh-TW": "記憶體快用完",
        "zh-CN": "内存快用完",
        "ja": "メモリが逼迫しています",
        "ko": "메모리가 거의 가득 찼습니다",
        "pt-BR": "Memória quase cheia"
      },
      "source": {
        "$": "sys.memory",
        "field": "percent",
        "fmt": "percent"
      },
      "op": ">=",
      "value": 92,
      "forSeconds": 120,
      "cooldownMinutes": 60,
      "message": {
        "en": "Memory use has stayed at {value} for two minutes.",
        "zh-TW": "記憶體用量已經維持 {value} 兩分鐘。",
        "zh-CN": "内存用量已维持 {value} 两分钟。",
        "ja": "メモリ使用率が 2 分間 {value} のままです。",
        "ko": "메모리 사용량이 2분 동안 {value}에 머물렀습니다.",
        "pt-BR": "O uso de memória ficou em {value} por dois minutos."
      }
    }
  ],
  "identityIcon": "data:image/png;base64,",
  "webUi": {
    "version": 1,
    "assets": [
      "ui/overview.html",
      "ui/cpu.html",
      "ui/memory.html",
      "ui/chart.css",
      "ui/chart.js"
    ],
    "documents": [
      {
        "id": "notch-chart",
        "target": "notch",
        "view": "overview",
        "variant": "full",
        "slot": "replace",
        "entry": "ui/overview.html",
        "height": 152
      },
      {
        "id": "cpu-chart",
        "target": "edgeDock",
        "view": "cpu",
        "variant": "full",
        "slot": "replace",
        "entry": "ui/cpu.html",
        "height": 168
      },
      {
        "id": "memory-chart",
        "target": "edgeDock",
        "view": "memory",
        "variant": "full",
        "slot": "replace",
        "entry": "ui/memory.html",
        "height": 168
      }
    ]
  }
}
