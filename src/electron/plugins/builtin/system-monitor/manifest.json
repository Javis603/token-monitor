{
  "id": "system-monitor",
  "version": "1.1.0",
  "tmApi": "^1",
  "name": {
    "en": "System Monitor",
    "zh-TW": "系統監控",
    "zh-CN": "系统监控",
    "ja": "システムモニター",
    "ko": "시스템 모니터",
    "pt-BR": "Monitor do sistema"
  },
  "description": {
    "en": "CPU and memory beside your token usage, with optional alerts when either stays high. Sampled only while shown or while an alert is on.",
    "zh-TW": "在 Token 用量旁顯示 CPU 與記憶體使用率，持續偏高時可發送通知。僅在畫面顯示或啟用告警時取樣。",
    "zh-CN": "在 Token 用量旁显示 CPU 和内存，持续偏高时可以通知。仅在显示或开启告警时采样。",
    "ja": "トークン使用量の横に CPU とメモリを表示し、高い状態が続くと通知できます。表示中またはアラート有効時のみ計測します。",
    "ko": "토큰 사용량 옆에 CPU와 메모리를 표시하고, 높은 상태가 계속되면 알릴 수 있습니다. 표시 중이거나 알림이 켜져 있을 때만 측정합니다.",
    "pt-BR": "CPU e memória ao lado do uso de tokens, com alertas opcionais quando ficam altas. Mede apenas enquanto aparece ou com um alerta ativo."
  },
  "author": "Token Monitor",
  "permissions": [
    "sys.cpu",
    "sys.memory",
    "notify",
    "ui.web",
    "tm.pages"
  ],
  "views": [
    {
      "id": "overview",
      "title": {
        "en": "System",
        "zh-TW": "系統",
        "zh-CN": "系统",
        "ja": "システム",
        "ko": "시스템",
        "pt-BR": "Sistema"
      },
      "icon": "gauge",
      "surfaces": [
        "home",
        "notch",
        "page"
      ],
      "layout": {
        "type": "stack",
        "dir": "col",
        "gap": 10,
        "children": [
          {
            "type": "stack",
            "dir": "row",
            "gap": 12,
            "align": "center",
            "children": [
              {
                "type": "ring",
                "size": 46,
                "value": {
                  "$": "sys.cpu"
                },
                "caption": {
                  "$": "sys.cpu",
                  "fmt": "percent"
                },
                "tone": {
                  "$": "sys.cpu",
                  "steps": [
                    [
                      0,
                      "ok"
                    ],
                    [
                      70,
                      "warn"
                    ],
                    [
                      90,
                      "bad"
                    ]
                  ]
                }
              },
              {
                "type": "stack",
                "dir": "col",
                "gap": 4,
                "flex": 1,
                "children": [
                  {
                    "type": "stack",
                    "dir": "row",
                    "justify": "between",
                    "children": [
                      {
                        "type": "text",
                        "text": "CPU",
                        "size": "xs",
                        "tone": "muted",
                        "weight": "medium"
                      },
                      {
                        "type": "text",
                        "text": {
                          "$": "sys.cpu",
                          "fmt": "percent"
                        },
                        "size": "xs",
                        "mono": true
                      }
                    ]
                  },
                  {
                    "type": "sparkline",
                    "series": {
                      "$": "sys.cpu",
                      "history": 60
                    },
                    "min": 0,
                    "max": 100,
                    "height": 28,
                    "fill": true,
                    "tone": "chart",
                    "smooth": true,
                    "windowMs": 120000
                  }
                ]
              }
            ]
          },
          {
            "type": "stack",
            "dir": "row",
            "gap": 12,
            "align": "center",
            "children": [
              {
                "type": "ring",
                "size": 46,
                "value": {
                  "$": "sys.memory",
                  "field": "percent"
                },
                "caption": {
                  "$": "sys.memory",
                  "field": "percent",
                  "fmt": "percent"
                },
                "tone": {
                  "$": "sys.memory",
                  "field": "percent",
                  "steps": [
                    [
                      0,
                      "ok"
                    ],
                    [
                      80,
                      "warn"
                    ],
                    [
                      92,
                      "bad"
                    ]
                  ]
                }
              },
              {
                "type": "stack",
                "dir": "col",
                "gap": 4,
                "flex": 1,
                "children": [
                  {
                    "type": "stack",
                    "dir": "row",
                    "justify": "between",
                    "children": [
                      {
                        "type": "text",
                        "text": {
                          "en": "Memory",
                          "zh-TW": "記憶體",
                          "zh-CN": "内存",
                          "ja": "メモリ",
                          "ko": "메모리",
                          "pt-BR": "Memória"
                        },
                        "size": "xs",
                        "tone": "muted",
                        "weight": "medium"
                      },
                      {
                        "type": "text",
                        "text": {
                          "$": "sys.memory",
                          "field": "used",
                          "fmt": "bytes"
                        },
                        "size": "xs",
                        "mono": true
                      }
                    ]
                  },
                  {
                    "type": "sparkline",
                    "series": {
                      "$": "sys.memory",
                      "field": "percent",
                      "history": 60
                    },
                    "min": 0,
                    "max": 100,
                    "height": 28,
                    "fill": true,
                    "tone": "accent",
                    "smooth": true,
                    "windowMs": 120000
                  }
                ]
              }
            ]
          }
        ]
      },
      "layouts": {
        "notch": {
          "type": "stack",
          "dir": "row",
          "gap": 28,
          "align": "stretch",
          "children": [
            {
              "type": "stack",
              "dir": "col",
              "gap": 8,
              "flex": 1,
              "children": [
                {
                  "type": "stack",
                  "dir": "row",
                  "justify": "between",
                  "align": "end",
                  "children": [
                    {
                      "type": "stat",
                      "label": "CPU",
                      "value": {
                        "$": "sys.cpu",
                        "fmt": "percent"
                      },
                      "size": "l",
                      "tone": {
                        "$": "sys.cpu",
                        "steps": [
                          [
                            0,
                            "default"
                          ],
                          [
                            70,
                            "warn"
                          ],
                          [
                            90,
                            "bad"
                          ]
                        ]
                      }
                    },
                    {
                      "type": "text",
                      "text": {
                        "en": "last 2 min",
                        "zh-TW": "最近 2 分鐘",
                        "zh-CN": "最近 2 分钟",
                        "ja": "直近 2 分",
                        "ko": "최근 2분",
                        "pt-BR": "últimos 2 min"
                      },
                      "size": "xs",
                      "tone": "muted"
                    }
                  ]
                },
                {
                  "type": "sparkline",
                  "series": {
                    "$": "sys.cpu",
                    "history": 60
                  },
                  "min": 0,
                  "max": 100,
                  "height": 96,
                  "fill": true,
                  "tone": "chart",
                  "smooth": true,
                  "windowMs": 120000
                }
              ]
            },
            {
              "type": "stack",
              "dir": "col",
              "gap": 8,
              "flex": 1,
              "children": [
                {
                  "type": "stack",
                  "dir": "row",
                  "justify": "between",
                  "align": "end",
                  "children": [
                    {
                      "type": "stat",
                      "label": {
                        "en": "Memory",
                        "zh-TW": "記憶體",
                        "zh-CN": "内存",
                        "ja": "メモリ",
                        "ko": "메모리",
                        "pt-BR": "Memória"
                      },
                      "value": {
                        "$": "sys.memory",
                        "field": "percent",
                        "fmt": "percent"
                      },
                      "size": "l",
                      "tone": {
                        "$": "sys.memory",
                        "field": "percent",
                        "steps": [
                          [
                            0,
                            "default"
                          ],
                          [
                            80,
                            "warn"
                          ],
                          [
                            92,
                            "bad"
                          ]
                        ]
                      }
                    },
                    {
                      "type": "text",
                      "text": {
                        "$": "sys.memory",
                        "field": "used",
                        "fmt": "bytes"
                      },
                      "size": "xs",
                      "tone": "muted",
                      "mono": true
                    }
                  ]
                },
                {
                  "type": "sparkline",
                  "series": {
                    "$": "sys.memory",
                    "field": "percent",
                    "history": 60
                  },
                  "min": 0,
                  "max": 100,
                  "height": 96,
                  "fill": true,
                  "tone": "accent",
                  "smooth": true,
                  "windowMs": 120000
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "cpu",
      "title": "CPU",
      "icon": "cpu",
      "surfaces": [
        "edgeDock",
        "tray",
        "home"
      ],
      "compact": {
        "label": "CPU",
        "value": {
          "$": "sys.cpu",
          "fmt": "percent"
        },
        "tone": {
