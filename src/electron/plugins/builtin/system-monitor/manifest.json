                    ],
                    [
                      70,
                      "warn"
                    ],
                    [
                      90,
                      "bad"
                    ]
                  ]
                }
              },
              {
                "type": "badge",
                "text": {
                  "$": "sys.cpu",
                  "fmt": "percent"
                },
                "tone": {
                  "$": "sys.cpu",
                  "steps": [
                    [
                      0,
                      "ok"
                    ],
                    [
                      70,
                      "warn"
                    ],
                    [
                      90,
                      "bad"
                    ]
                  ]
                }
              }
            ]
          },
          {
            "type": "sparkline",
            "series": {
              "$": "sys.cpu",
              "history": 60
            },
            "min": 0,
            "max": 100,
            "height": 44,
            "fill": true,
            "tone": "chart",
            "smooth": true,
            "windowMs": 120000
          }
        ]
      }
    },
    {
      "id": "memory",
      "title": {
