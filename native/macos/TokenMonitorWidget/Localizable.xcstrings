        "ko": { "stringUnit": { "state": "translated", "value": "사용량 요약" } }
      }
    },
    "Choose the usage period shown by this widget.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose the usage period shown by this widget." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择此小组件显示的用量周期。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "選擇此小工具顯示的用量週期。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このウィジェットに表示する使用期間を選択します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 위젯에 표시할 사용량 기간을 선택합니다." } }
      }
    },
    "Usage Breakdown": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Usage Breakdown" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "用量明细" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "用量明細" } },
        "ja": { "stringUnit": { "state": "translated", "value": "使用量の内訳" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사용량 분석" } }
      }
    },
    "Choose a tool or model breakdown and its period.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose a tool or model breakdown and its period." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择工具或模型明细及其统计周期。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "選擇工具或模型明細及其統計週期。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ツールまたはモデルの内訳と期間を選択します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "도구 또는 모델 분석과 기간을 선택합니다." } }
      }
    },
    "Dashboard": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Dashboard" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "仪表盘" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "儀表板" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ダッシュボード" } },
        "ko": { "stringUnit": { "state": "translated", "value": "대시보드" } }
      }
    },
    "Choose the dashboard period, breakdown, and quota display mode.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose the dashboard period, breakdown, and quota display mode." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择仪表盘的统计周期、明细和额度显示模式。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "選擇儀表板的統計週期、明細和額度顯示模式。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ダッシュボードの期間、内訳、クォータ表示モードを選択します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "대시보드의 기간, 분석 및 할당량 표시 모드를 선택합니다." } }
      }
    },
    "Show quota accounts automatically or choose up to two.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Show quota accounts automatically or choose up to two." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "自动显示额度账户，或选择最多两个账户。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "自動顯示額度帳號，或選擇最多兩個帳號。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "クォータアカウントを自動表示するか、最大2つ選択します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "할당량 계정을 자동으로 표시하거나 최대 2개를 선택합니다." } }
      }
    },
    "Token Monitor Dashboard": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Token Monitor Dashboard" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Token Monitor 仪表盘" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "Token Monitor 儀表板" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Token Monitor ダッシュボード" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Token Monitor 대시보드" } }
      }
    },
    "Usage, quota, breakdown, and activity in one dashboard.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Usage, quota, breakdown, and activity in one dashboard." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在一个仪表盘中查看用量、额度、明细和活动。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在一個儀表板中查看用量、額度、明細和活動。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "使用量、クォータ、内訳、アクティビティを1つのダッシュボードで確認できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사용량, 할당량, 분석 및 활동을 하나의 대시보드에서 확인합니다." } }
      }
    },
    "Token Monitor Summary": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Token Monitor Summary" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Token Monitor 摘要" } },
