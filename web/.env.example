# Copy to .env, chmod 600, then set the same secret as your Hub.
TOKEN_MONITOR_SECRET=
HUB_URL=http://127.0.0.1:17321
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4174

# local (default): browser + API restricted to loopback with Host validation.
# proxy: dedicated origin behind an authenticating reverse proxy.
WEB_AUTH_MODE=local
# Required in proxy mode; independent random session-signing secret (>=16 chars).
# In local mode omission generates an ephemeral key at startup.
GATEWAY_SESSION_SECRET=
