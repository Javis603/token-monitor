# Copy to .env, chmod 600, and edit locally. Never commit real credentials.
TOKEN_MONITOR_SECRET=
HUB_URL=http://127.0.0.1:17321
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4174

# local | basic | oidc | trusted-proxy
WEB_AUTH_MODE=local
# Required for basic, oidc, or trusted-proxy external; HTTPS outside loopback.
WEB_PUBLIC_ORIGIN=

# Basic only: separate from the Hub bearer.
WEB_BASIC_USERNAME=
WEB_BASIC_PASSWORD=

# OIDC only: callback is WEB_PUBLIC_ORIGIN/auth/callback.
WEB_OIDC_ISSUER=
WEB_OIDC_CLIENT_ID=
WEB_OIDC_CLIENT_SECRET=
# Optional subject allowlist; omitted means any authenticated issuer user.
WEB_OIDC_ALLOWED_SUBJECTS=

# Trusted Proxy only. Identity headers are trusted only from these socket peers.
WEB_TRUSTED_PROXY_PEERS=127.0.0.1,::1
WEB_TRUSTED_PROXY_MODE=header
WEB_TRUSTED_PROXY_HEADER=x-forwarded-user
# external mode must be explicitly selected for identity-less auth offload.
# See README: upstream must protect all non-API routes, not merely /.
