        }
      }
    },
    "Record subscriptions in the Desktop app connected to this Hub.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record subscriptions in the Desktop app connected to this Hub."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在連接此 Hub 的桌面 App 記錄訂閱。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在连接此 Hub 的桌面 App 记录订阅。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Hub に接続したデスクトップアプリで記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Hub에 연결된 데스크톱 앱에서 구독을 기록하세요."
          }
        }
      }
    },
    "Recurring plans are normalized by their billing interval; top-ups include this calendar month’s payments. Expired plans are excluded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurring plans are normalized by their billing interval; top-ups include this calendar month’s payments. Expired plans are excluded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定期方案按帳單週期換算；儲值計入本月付款。已到期方案不計入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定期方案按账单周期换算；充值计入本月付款。已到期方案不计入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期プランは請求間隔で月額に換算し、チャージは今月の入金を集計します。期限切れプランは除外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 요금은 결제 주기로 환산하고 충전은 이번 달 결제를 합산합니다. 만료된 요금제는 제외합니다."
          }
        }
      }
    },
    "Manage these shared records in the Desktop app connected to this Hub.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage these shared records in the Desktop app connected to this Hub."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在連接此 Hub 的桌面 App 管理共享紀錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在连接此 Hub 的桌面 App 管理共享记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Hub に接続したデスクトップアプリで共有記録を管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Hub에 연결된 데스크톱 앱에서 공유 기록을 관리하세요."
          }
        }
      }
    },
    "This Hub does not support shared subscription records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Hub does not support shared subscription records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Hub 不支援共享訂閱紀錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Hub 不支持共享订阅记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Hub は共有サブスクリプション記録に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Hub는 공유 구독 기록을 지원하지 않습니다."
          }
        }
      }
    },
    "Connect a Hub to view shared subscription records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Hub to view shared subscription records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 Hub 以檢視共享訂閱紀錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Hub 以查看共享订阅记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub に接続して共有記録を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub에 연결하여 공유 구독 기록을 확인하세요."
          }
        }
      }
    },
    "No live model timing available": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No live model timing available"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無模型即時計時資料"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无模型实时计时数据"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのライブ計測データなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 모델 시간 데이터 없음"
          }
        }
      }
    },
    "Live speed uses consecutive timed output samples. It is separate from the selected period’s average.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live speed uses consecutive timed output samples. It is separate from the selected period’s average."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時速度根據連續輸出計時樣本計算，與所選時段的平均值分開。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时速度根据连续输出计时样本计算，与所选时段的平均值分开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ速度は連続した出力の計測値に基づき、選択期間の平均とは異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 속도는 연속 출력 시간 샘플을 사용하며 선택 기간의 평균과 별개입니다."
          }
        }
      }
    },
    "Running and waiting sessions remain visible beyond this count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running and waiting sessions remain visible beyond this count."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過此數量的執行中及等候中工作階段仍會顯示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过此数量的运行中及等待中会话仍会显示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中・待機中のセッションはこの件数を超えても表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중 및 대기 중인 세션은 이 개수를 초과해도 표시합니다."
          }
        }
      }
    },
    "Show live speed by model": {
      "localizations": {
