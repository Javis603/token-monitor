    "Showing the last loaded subscription records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the last loaded subscription records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前顯示上次載入的訂閱紀錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示上次加载的订阅记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回読み込んだ記録を表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 불러온 구독 기록을 표시합니다."
