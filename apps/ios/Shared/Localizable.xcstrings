          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템은 iPhone의 화면 모드를 따릅니다. 표시 설정은 데스크톱 앱에 영향을 주지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统”会跟随 iPhone 的外观设置。这里的显示偏好不会改变桌面 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「系統」會跟隨 iPhone 的外觀設定。這裡的顯示偏好不會改變桌面 App。"
          }
        }
      }
    },
    "Tap the eye to show or hide a provider. Tap Edit to reorder." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the eye to show or hide a provider. Tap Edit to reorder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目のアイコンで表示を切り替えます。「編集」で順序を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눈 아이콘으로 제공업체를 표시하거나 숨깁니다. 편집을 눌러 순서를 변경하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按眼睛图标以显示或隐藏提供商；点按“编辑”可调整顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下眼睛圖示以顯示或隱藏供應商；點「編輯」可調整順序。"
          }
        }
      }
    },
    "The iOS app reads your existing Token Monitor Hub. It never runs local collectors." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS アプリは既存の Token Monitor Hub を読み取ります。ローカル収集は実行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 앱은 기존 Token Monitor Hub의 데이터를 읽으며 로컬 수집기를 실행하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
