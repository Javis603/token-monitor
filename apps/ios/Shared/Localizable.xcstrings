    "The iOS app reads your existing Token Monitor Hub. It never runs local collectors.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS アプリは既存の Token Monitor Hub を読み取ります。ローカル収集は実行しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 앱은 기존 Token Monitor Hub의 데이터를 읽으며 로컬 수집기를 실행하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS App 读取现有 Token Monitor Hub，不会运行本地采集器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS App 會讀取現有的 Token Monitor Hub，不會執行本機收集器。"
          }
        }
      }
    },
    "The shared secret is stored in the iOS Keychain.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
