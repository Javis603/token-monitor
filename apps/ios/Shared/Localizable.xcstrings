          }
        }
      }
    },
    "These are the defaults for new widgets. Long-press a widget and choose Edit Widget to override its content." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウィジェットの初期値です。ウィジェットを長押しして編集すると個別に変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 위젯의 기본값입니다. 위젯을 길게 눌러 편집하면 개별 설정을 변경할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
