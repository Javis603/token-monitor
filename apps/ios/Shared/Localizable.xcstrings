    "Live Activity shows a glanceable metric on the Lock Screen and Dynamic Island. Open the app periodically so iOS can receive fresh Hub data.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面と Dynamic Island に指標を表示します。最新の Hub データを受信できるよう、定期的にアプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면과 Dynamic Island에 지표를 표시합니다. 최신 Hub 데이터를 받도록 가끔 앱을 열어 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕与灵动岛显示一目了然的指标。请定期打开 App，让 iOS 接收最新 Hub 数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鎖定畫面與動態島顯示一目了然的指標。請定期開啟 App，讓 iOS 接收最新 Hub 資料。"
          }
        }
      }
    },
