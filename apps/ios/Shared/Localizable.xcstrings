        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 비밀키는 iOS 키체인에 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享密钥储存在 iOS 钥匙串中。"
