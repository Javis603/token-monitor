          }
        }
      }
    },
    "This Hub doesn't support Live Activity push yet. Deploy the latest Worker with APNs configured to get background updates." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Hub doesn't support Live Activity push yet. Deploy the latest Worker with APNs configured to get background updates."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHubはまだライブアクティビティプッシュに対応していません。APNsを設定した最新のWorkerをデプロイするとバックグラウンド更新を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 허브는 아직 실시간 현황 푸시를 지원하지 않습니다. APNs가 구성된 최신 Worker를 배포하면 백그라운드 업데이트를 받을 수 있습니다."
          }
