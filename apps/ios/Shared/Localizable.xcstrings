    "Automatic follows the selected limit provider, then the most active model.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會跟隨所選的額度供應商，然後是最活躍的模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会跟随所选的额度供应商，然后是最活跃的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」は選択した上限プロバイダー、次に最もアクティブなモデルに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 선택한 한도 제공자, 다음으로 가장 활동량이 많은 모델을 따릅니다."
          }
        }
      }
    },
