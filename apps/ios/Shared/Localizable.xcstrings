    "Showing the last received data. Pull to refresh or check your Hub connection.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正顯示上次收到的資料。下拉重新整理或檢查 Hub 連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正显示上次收到的数据。下拉刷新或检查 Hub 连接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に受信した情報を表示しています。下に引いて更新するか、Hub への接続を確認してください。"
