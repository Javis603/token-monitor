          }
        }
      }
    },
    "Some session details were omitted by the sending device. Usage totals still include them.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送裝置省略了部分會話資料，用量總計仍包含這些會話。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送设备省略了部分会话数据，用量总计仍包含这些会话。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信デバイスが一部のセッション情報を省略しました。合計使用量には含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 기기가 일부 세션 정보를 생략했습니다. 총 사용량에는 포함되어 있습니다."
          }
        }
      }
    },
