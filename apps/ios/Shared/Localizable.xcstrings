    "Hub costs are stored in USD and converted for display using the same rates as Token Monitor Desktop.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub のコストは USD で保存され、Desktop 版と同じレートで表示通貨に換算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub 비용은 USD로 저장되며 데스크톱 앱과 동일한 환율로 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub 费用以 USD 储存，并使用与桌面版相同的汇率转换显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub 費用以 USD 儲存，並使用與 Desktop 相同的匯率換算顯示。"
          }
        }
      }
    },
